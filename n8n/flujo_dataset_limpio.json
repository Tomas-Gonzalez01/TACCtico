    {
      "name": "Validar archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "dd6ebf65-b707-505e-a893-1beb1a242893",
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (!items.length) throw new Error('El CSV está vacío.');\nconst required = ['idPublicacion','articuloTitulo','nuevoPrecio','Moneda','zProductoLink','Tiempo'];\nconst missing = required.filter(key => !items.some(item => Object.prototype.hasOwnProperty.call(item.json, key)));\nif (missing.length) throw new Error('Faltan columnas: ' + missing.join(', '));\nreturn items;"
      }
    },
    {
      "name": "Limpiar y guardar lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "616ce236-98c0-5a7a-822f-b43686aa70da",
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "pythonNative",
        "pythonCode": "from tacctico_etl import ejecutar\nresultado = ejecutar(_items)\nif not resultado[\"publicable\"]:\n    raise ValueError(\"Hay filas rechazadas. Revisá rechazados.csv en la carpeta del lote. El dataset vigente no cambió.\")\nreturn [{\"json\": resultado}]"
      }
    },
    {
      "name": "CSV listo para TACCtico",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "id": "b3e80bd9-5e54-514a-8527-55a5b7efafc7",
      "position": [
        960,
        0
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "=/files/lotes/{{ $json.lote }}/mercadolibre_validado.csv",
        "options": {
          "fileName": "mercadolibre_validado.csv",
          "mimeType": "text/csv",
          "dataPropertyName": "dataset_limpio"
        }
      }
    },
    {
      "name": "Cómo usar",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "id": "e8fa48cb-4dd9-51ae-bf6e-bdfeadd318d1",
      "position": [
        180,
        240
      ],
      "parameters": {
        "content": "## Dataset limpio para TACCtico\n1. Ejecutá el flujo y cargá el CSV crudo en el formulario.\n2. Revisá el resumen de Limpiar y guardar lote.\n3. Descargá dataset_limpio desde el último nodo.\n\nCada lote queda en n8n/storage/lotes. Repetir el mismo archivo reutiliza el lote. Si falla un control, se conserva el vigente.\n\nLa conexión a Drive se agrega cuando esté autorizada. No incluye EDA ni métricas.",
        "height": 300,
        "width": 740
      }
    }
